# Base URL of the Django backend API (see backend/config/urls.py - everything
# is mounted under /api/). Copy this file to .env.local for local dev.
#
# Local dev (default if unset):
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
#
# Production (Vercel): set this to your deployed Render backend, e.g.
# NEXT_PUBLIC_API_BASE_URL=https://bike-meter-erp-api.onrender.com/api
