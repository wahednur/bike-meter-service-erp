# This machine's user-level npm config restricts which packages may run
# install scripts (allow-scripts is scoped to @anthropic-ai/claude-code
# only). Rather than relying on --ignore-scripts on every manual install,
# set it here so it also applies to installs run internally by tools like
# `npx shadcn add ...`. Nothing in this stack (Next.js/Tailwind/Radix/shadcn)
# has needed a postinstall script so far.
ignore-scripts=true
