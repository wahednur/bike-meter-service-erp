DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Local development uses these discrete DB_* vars.
DB_NAME=dj_bike_meter_erp
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# In production, set DATABASE_URL instead (e.g. a Neon/Supabase Postgres
# connection string). When set, it takes priority over the DB_* vars above.
# Example: postgres://user:password@host:5432/dbname?sslmode=require
# DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required in production so Django trusts POSTs (e.g. /admin/ login) coming
# from your deployed frontend/backend origins. Must include the scheme, no
# trailing slash. Note: settings.py already auto-adds the backend's own
# https://<RENDER_EXTERNAL_HOSTNAME> (set automatically by Render) to both
# ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS, so you mainly need to list the
# frontend origin(s) here.
# CSRF_TRUSTED_ORIGINS=https://your-backend.onrender.com,https://your-frontend.vercel.app
